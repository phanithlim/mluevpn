# ---------------------------------------------------------------- secrets
# Nothing here is ever safe to publish. The database holds your encrypted
# credentials and master.key is what opens it; a stray .ovpn usually carries a
# private key and a certificate. These live in ~/.local/share/mluevpn, but the
# patterns are here so a copy dropped in the project directory cannot slip out.
*.db
*.db-journal
*.db-wal
master.key
*.key
*.pem
*.p12
*.ovpn
.env
.env.*

# ------------------------------------------------------------ virtualenvs
# Machine-specific, and the one thing that must never reach a package build.
.venv/
venv/
env/
.direnv/

# --------------------------------------------------- Python build output
__pycache__/
*.py[cod]
dist/
build/
*.egg-info/

# ------------------------------------------------------- packaging output
# Regenerated by packaging/build.sh; src/ and pkg/ are makepkg scratch dirs.
packaging/src/
packaging/pkg/
*.pkg.tar.zst
*.tar.gz
*.log

# ------------------------------------------------------ tooling and editors
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/
.idea/
.vscode/
.claude/settings.local.json
*.swp
*.swo
*~
*.orig
*.rej

# --------------------------------------------------------------- OS cruft
.DS_Store
Thumbs.db

# makepkg scratch dirs under the AUR recipe
packaging/aur/src/
packaging/aur/pkg/

# Local clone of the AUR package repo (ssh://aur@aur.archlinux.org/mluevpn.git).
# A separate git repo that lives here for convenience; committing it would add a
# gitlink to a commit no one outside the AUR remote can fetch.
aur-mluevpn/
